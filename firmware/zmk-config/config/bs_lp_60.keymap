#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/ext_power.h>

#define BAS_L 0
#define NAV_L 1

/ {
	// Double Tap: single tap sends the first key, double tap the second.
	// Both keys are chosen per key in Keyform (Advanced -> Double Tap), no reflashing needed.
	// tapping-term-ms is how long it waits for a second tap (Normal 200, Fast 150, Relaxed 250, plus every 5 ms from 150 to 300).
	behaviors {
		// Game Mod-Tap: mod-tap that holds the tap key long enough for games to see it.
		// All its settings are stored per key and set in Keyform (Advanced -> Game Mod-Tap).
		gmt: game_mod_tap {
			compatible = "zmk,behavior-game-mod-tap";
			display-name = "Game Mod-Tap";
			#binding-cells = <2>;
		};
		dbl: double_tap {
			compatible = "zmk,behavior-double-tap";
			display-name = "Double Tap";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
		};
		// Same, with a shorter / longer wait. Keyform shows these as the Speed choice of Double Tap.
		dbl_fast: double_tap_fast {
			compatible = "zmk,behavior-double-tap";
			display-name = "Double Tap (Fast)";
			#binding-cells = <2>;
			tapping-term-ms = <150>;
		};
		dbl_relaxed: double_tap_relaxed {
			compatible = "zmk,behavior-double-tap";
			display-name = "Double Tap (Relaxed)";
			#binding-cells = <2>;
			tapping-term-ms = <250>;
		};
		// Extra speeds for the Keyform slider, 150-300 ms in steps of 5 (150, 200 and 250 are the three above).
		// Keep the node names: saved keys refer to them by name.
		double_tap_155 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (155 ms)"; #binding-cells = <2>; tapping-term-ms = <155>; };
		double_tap_160 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (160 ms)"; #binding-cells = <2>; tapping-term-ms = <160>; };
		double_tap_165 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (165 ms)"; #binding-cells = <2>; tapping-term-ms = <165>; };
		double_tap_170 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (170 ms)"; #binding-cells = <2>; tapping-term-ms = <170>; };
		double_tap_175 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (175 ms)"; #binding-cells = <2>; tapping-term-ms = <175>; };
		double_tap_180 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (180 ms)"; #binding-cells = <2>; tapping-term-ms = <180>; };
		double_tap_185 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (185 ms)"; #binding-cells = <2>; tapping-term-ms = <185>; };
		double_tap_190 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (190 ms)"; #binding-cells = <2>; tapping-term-ms = <190>; };
		double_tap_195 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (195 ms)"; #binding-cells = <2>; tapping-term-ms = <195>; };
		double_tap_205 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (205 ms)"; #binding-cells = <2>; tapping-term-ms = <205>; };
		double_tap_210 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (210 ms)"; #binding-cells = <2>; tapping-term-ms = <210>; };
		double_tap_215 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (215 ms)"; #binding-cells = <2>; tapping-term-ms = <215>; };
		double_tap_220 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (220 ms)"; #binding-cells = <2>; tapping-term-ms = <220>; };
		double_tap_225 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (225 ms)"; #binding-cells = <2>; tapping-term-ms = <225>; };
		double_tap_230 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (230 ms)"; #binding-cells = <2>; tapping-term-ms = <230>; };
		double_tap_235 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (235 ms)"; #binding-cells = <2>; tapping-term-ms = <235>; };
		double_tap_240 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (240 ms)"; #binding-cells = <2>; tapping-term-ms = <240>; };
		double_tap_245 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (245 ms)"; #binding-cells = <2>; tapping-term-ms = <245>; };
		double_tap_255 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (255 ms)"; #binding-cells = <2>; tapping-term-ms = <255>; };
		double_tap_260 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (260 ms)"; #binding-cells = <2>; tapping-term-ms = <260>; };
		double_tap_265 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (265 ms)"; #binding-cells = <2>; tapping-term-ms = <265>; };
		double_tap_270 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (270 ms)"; #binding-cells = <2>; tapping-term-ms = <270>; };
		double_tap_275 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (275 ms)"; #binding-cells = <2>; tapping-term-ms = <275>; };
		double_tap_280 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (280 ms)"; #binding-cells = <2>; tapping-term-ms = <280>; };
		double_tap_285 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (285 ms)"; #binding-cells = <2>; tapping-term-ms = <285>; };
		double_tap_290 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (290 ms)"; #binding-cells = <2>; tapping-term-ms = <290>; };
		double_tap_295 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (295 ms)"; #binding-cells = <2>; tapping-term-ms = <295>; };
		double_tap_300 { compatible = "zmk,behavior-double-tap"; display-name = "Double Tap (300 ms)"; #binding-cells = <2>; tapping-term-ms = <300>; };
	};

	keymap {
		compatible = "zmk,keymap";
		
		default_layer {
// ------------------------------------------------------------------------------------------
// | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BKSP   |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   "|"   |
// | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
// |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |      SHIFT       |
// |  CTL  |  WIN  |  ALT  |            SPACE              |  ALT  |  WIN  |  MO(1) |  CTL  |
// ------------------------------------------------------------------------------------------
            label = "Base";

			bindings = <
	&gresc  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL  &kp BSPC
	&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH
	&kp CLCK  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT           &kp RET
	&kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH           &kp RSHFT
	&kp LCTRL &kp LGUI &kp LALT             &kp SPACE                     &kp RALT  &kp RGUI  &mo NAV_L   &kp RCTRL
			>;
		};

		ble_layer {
// ------------------------------------------------------------------------------------------------
// | BT CLR | F1  | F2  | F3  | F4  | F5  | F6  | F7  | F8  | F9  | F10  | F11 | F12 |            |
// |  BT 1   |   |  UP |   |       |       |       |       |   |     |    |     |     |           |
// |   BT 2   | LT |  DN  | RT |       |       |       |       |   |     |   |     |              |
// |    BT 3     |     |      |      |     |     |     |     |     |     |     |                  |
// |   BT 4  |      |      |                                    | PRT SCR |       |       |  DEL  |
// ------------------------------------------------------------------------------------------------
            label = "Nav";

			bindings = <
	&bt BT_CLR   &kp F1    &kp F2    &kp F3  &kp F4           &kp F5          &kp F6          &kp F7          &kp F8   &kp F9   &kp F10  &kp F11 &kp F12  &trans
	&bt BT_SEL 0  &trans    &kp UP    &trans  &trans  &trans &trans &trans  &trans   &trans   &trans   &trans  &trans          &trans 
	&bt BT_SEL 1   &kp LEFT  &kp DOWN  &kp RIGHT &trans &trans &trans &trans &trans   &trans   &trans   &trans        &trans
	&bt BT_SEL 2    &trans    &trans    &trans   &trans          &trans          &trans          &trans          &trans   &trans   &trans               &trans
	&bt BT_SEL 3  &trans   &trans                            &trans                                     &kp PSCRN      &trans      &trans               &kp DEL
			>;
		};
			extra_layer_1 {
			status = "reserved";
			bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
		};

		extra_layer_2 {
			status = "reserved";
			bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
		};

		extra_layer_3 {
			status = "reserved";
			bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
		};

		extra_layer_4 {
			status = "reserved";
			bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
		};

		extra_layer_5 {
			status = "reserved";
			bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
		};

		extra_layer_6 {
			status = "reserved";
			bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
		};
	};
};